APP_NAME=CRMNAVARRO
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- CONFIGURACIÓN DE BASE DE DATOS (IMPORTANTE) ---
DB_CONNECTION=sqlite
# Las líneas de DB_HOST, PORT, etc., no son necesarias para SQLite

# --- DRIVERS DE SESIÓN Y CACHÉ (CAMBIADOS A FILE PARA QUE NO DEN ERROR) ---
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync